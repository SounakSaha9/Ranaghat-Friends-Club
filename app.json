{
  "expo": {
    "name": "Ranaghat Friends Club",
    "slug": "cricket-academy-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "cricket-academy",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cricketacademy.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1b5e20",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.cricketacademy.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-splash-screen",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5a92ee93-1fe7-44ab-b62e-5ebe506ca209"
      }
    },
    "owner": "sounak-cosx"
  }
}
